---
import { buildUrl } from 'src/util/link';

export type TypographyProps = {
  typography: {
    type: string;
    href: string;
  }[];
};

type Props = TypographyProps;

const { typography } = Astro.props;
---
{typography && typography.map((element) => {
  return (
    <link
      as='font'
      crossorigin
      rel='preload'
      type={element.type}
      href={buildUrl(element.href, Astro.site)}
    />
  );
})}